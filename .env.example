# API Sentinel Environment Variables Configuration Example
# Copy this file to .env and adjust values for your environment.

# Django Security
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration (Leave empty for default SQLite, or provide postgresql URL)
# Example: postgresql://postgres:password@localhost:5432/apisentinel
DATABASE_URL=

# Data Encryption Key for API Credentials & Secrets (Fernet 32-byte urlsafe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=Y7Bo5ypgzngWFj79Ejp88M0n98phEYrjhhCrZ-5dAPs=

# SSRF and Outbound HTTP Security
SSRF_STRICT_MODE=True
HTTP_CLIENT_TIMEOUT=10
HTTP_MAX_RESPONSE_BYTES=1048576

# Email / Alert Notification Settings (Optional SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=alerts@apisentinel.local
